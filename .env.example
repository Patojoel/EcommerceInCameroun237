# =============================================================
# TEMPLATE VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS COMMITTER .env.local dans Git
# =============================================================

# --- BASE DE DONNÉES ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- NEXT AUTH ---
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-très-long-et-aléatoire"
# En local : http://localhost:3000 | En prod : https://votredomaine.com
NEXTAUTH_URL="http://localhost:3000"

# --- GOOGLE OAUTH (optionnel) ---
# https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- STRIPE ---
# Clés test : sk_test_... / pk_test_...
# Clés live : sk_live_... / pk_live_...
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Depuis le dashboard Stripe > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- CLOUDINARY ---
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="votre-api-secret"

# --- EMAIL (Resend) ---
# https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@votredomaine.com"

GOOGLE_SHEET_WEBHOOK_URL=""

# --- APP ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nom de votre boutique"

# --- ANALYTICS (optionnel) ---
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
